@page "/shift"
@using Models
@using DBL
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager Nav
@inject ProtectedSessionStorage MySession

<style>
    /* Custom Pink/Cloud Aesthetic - Pure CSS */
    .shift-container {
        margin: 0;
        padding: 40px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #fff5f7 0%, #ffe4e9 50%, #f0f4ff 100%);
        min-height: 100vh;
        color: #444;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(15px);
        border-radius: 30px;
        padding: 30px;
        width: 100%;
        max-width: 1000px;
        box-shadow: 0 10px 30px rgba(255, 182, 193, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.6);
        margin-bottom: 30px;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        max-width: 1000px;
        margin-bottom: 20px;
    }

    .title-text {
        color: #d63384;
        font-weight: 300;
        margin: 0;
    }

    /* Table Styling */
    .shift-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        margin-top: 20px;
    }

        .shift-table th {
            background-color: #ffb6c1;
            color: white;
            padding: 15px;
            text-align: left;
        }

        .shift-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #ffe4e9;
            font-size: 0.9em;
        }

    /* Form and Inputs */
    .input-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .label-style {
        display: block;
        color: #ff85a1;
        margin-bottom: 5px;
        font-size: 0.85em;
        font-weight: bold;
    }

    .custom-input {
        padding: 12px;
        border-radius: 15px;
        border: 2px solid #ffe4e9;
        outline: none;
        width: 100%;
        box-sizing: border-box;
        transition: 0.3s;
    }

        .custom-input:focus {
            border-color: #ffb6c1;
        }

    /* Buttons */
    .btn-base {
        padding: 12px 20px;
        border-radius: 20px;
        border: none;
        cursor: pointer;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-add {
        background: #d63384;
        color: white;
        width: 100%;
    }

        .btn-add:hover {
            background: #b82a6f;
            transform: scale(1.02);
        }

    .btn-back {
        background: white;
        border: 1px solid #ff85a1;
        color: #ff85a1;
    }

    .btn-delete {
        background: #ff85a1;
        color: white;
        font-size: 0.8em;
        padding: 6px 12px;
    }

    .error-msg {
        background: #f8d7da;
        color: #842029;
        padding: 12px;
        border-radius: 15px;
        margin-bottom: 15px;
        border: 1px solid #f5c2c7;
        font-size: 0.9em;
    }

    .badge {
        padding: 4px 10px;
        border-radius: 10px;
        font-size: 0.8em;
        font-weight: bold;
    }

    .morning {
        background: #e0f2f1;
        color: #00796b;
    }

    .evening {
        background: #fff3e0;
        color: #e65100;
    }
</style>

<div class="shift-container" dir="ltr">
    <div class="top-bar">
        <h2 class="title-text">Shift Management</h2>
        <button class="btn-base btn-back" @onclick='() => Nav.NavigateTo("/dashboard")'>Return</button>
    </div>

    @if (currentUser != null)
    {
        <div class="glass-card">
            <h3 style="color: #ff85a1; margin: 0;">New Shift Entry</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-msg">@errorMessage</div>
            }

            <div class="input-grid">
                <div>
                    <span class="label-style">Date</span>
                    <input type="date" class="custom-input" @bind="inputDate" />
                </div>
                <div>
                    <span class="label-style">Shift Type</span>
                    <select class="custom-input" @bind="selectedType">
                        @foreach (var type in Enum.GetValues(typeof(Shift.ShiftType)))
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div>
                    <span class="label-style">Start Time</span>
                    <input type="time" class="custom-input" @bind="inputStartTime" />
                </div>
                <div>
                    <span class="label-style">End Time</span>
                    <input type="time" class="custom-input" @bind="inputEndTime" />
                </div>
                <div style="display: flex; align-items: flex-end;">
                    <button class="btn-base btn-add" @onclick="HandleAddShift">Create Shift</button>
                </div>
            </div>
        </div>

        <div class="glass-card">
            <h3 style="color: #ff85a1; margin: 0;">Operational Schedule</h3>
            <table class="shift-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Hours</th>
                        <th>Employee Assignment</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in allShifts)
                    {
                        <tr>
                            <td>@s.DateTime.ToShortDateString()</td>
                            <td>
                                <span class="badge @(s.Type == Shift.ShiftType.Morning ? "morning" : "evening")">
                                    @s.Type
                                </span>
                            </td>
                            <td>@s.Start.ToString("HH:mm") - @s.End.ToString("HH:mm")</td>
                            <td>
                                <select class="custom-input" style="padding: 5px;" @onchange="(e) => HandleUpdateEmployee(s, e.Value.ToString())">
                                    <option value="0">Not Assigned</option>
                                    @foreach (var emp in activeEmployees)
                                    {
                                        <option value="@emp.EmployeeID" selected="@(emp.EmployeeID == s.EmployCode)">
                                            @emp.NationalID
                                        </option>
                                    }
                                </select>
                            </td>
                            <td>
                                <button class="btn-base btn-delete" @onclick="() => HandleDelete(s.ShiftId)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="glass-card">Validating Credentials...</div>
    }
</div>

@code {
    // Initializing Data Access Objects locally (No @inject)
    private ShiftDB shiftDb = new ShiftDB();
    private EmployeeDB employeeDb = new EmployeeDB();

    private Employee currentUser;
    private List<Shift> allShifts = new();
    private List<Employee> activeEmployees = new();

    // UI State Management
    private string errorMessage = "";
    private DateTime inputDate = DateTime.Today;
    private Shift.ShiftType selectedType = Shift.ShiftType.Morning;
    private DateTime inputStartTime = DateTime.Today.AddHours(8);
    private DateTime inputEndTime = DateTime.Today.AddHours(16);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Verify session storage for current logged-in manager
            var result = await MySession.GetAsync<Employee>("CurrentUser");
            if (result.Success && result.Value != null && result.Value.IsManager)
            {
                currentUser = result.Value;
                await RefreshData();
                StateHasChanged();
            }
            else
            {
                Nav.NavigateTo("/login");
            }
        }
    }

    /// <summary>
    /// Updates local lists by fetching fresh data from the database.
    /// </summary>
    private async Task RefreshData()
    {
        allShifts = await shiftDb.GetAllShiftsAsync();
        activeEmployees = await employeeDb.GetAllEmployeesAsync(false);
    }

    /// <summary>
    /// Processes manual validation and inserts a new shift record.
    /// </summary>
    private async Task HandleAddShift()
    {
        // Manual validation check for time logic
        if (inputEndTime.TimeOfDay <= inputStartTime.TimeOfDay)
        {
            errorMessage = "End time must be strictly after the start time.";
            return;
        }

        if (inputDate == DateTime.MinValue)
        {
            errorMessage = "Please select a valid date for the shift.";
            return;
        }

        errorMessage = "";

        // Creating full DateTime objects to avoid NULL issues in SQL
        DateTime fullStart = new DateTime(inputDate.Year, inputDate.Month, inputDate.Day,
                                        inputStartTime.Hour, inputStartTime.Minute, 0);
        DateTime fullEnd = new DateTime(inputDate.Year, inputDate.Month, inputDate.Day,
                                      inputEndTime.Hour, inputEndTime.Minute, 0);

        Shift newShift = new Shift
            {
                DateTime = inputDate,
                Type = selectedType,
                Start = fullStart,
                End = fullEnd,
                EmployCode = 0 // Initializing as unassigned
            };

        try
        {
            await shiftDb.AddShiftAsync(newShift);
            await RefreshData();
        }
        catch (Exception ex)
        {
            errorMessage = "Database Error: " + ex.Message;
        }
    }

    /// <summary>
    /// Assigns or unassigns an employee to a shift based on dropdown selection.
    /// </summary>
    private async Task HandleUpdateEmployee(Shift shift, string value)
    {
        int empId = int.Parse(value);
        await shiftDb.AssignEmployeeToShiftAsync(shift.ShiftId, empId == 0 ? null : empId);
        shift.EmployCode = empId;
    }

    /// <summary>
    /// Deletes a shift record from the database.
    /// </summary>
    private async Task HandleDelete(int id)
    {
        await shiftDb.DeleteShiftAsync(id);
        await RefreshData();
    }
}