@page "/invoice"
@using Models
@using DBL
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject NavigationManager NavManager

<style>
    /* Cloud-like pink aesthetic - Consistent with Dashboard */
    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #fff5f7 0%, #ffe4e9 50%, #f0f4ff 100%);
        min-height: 100vh;
        color: #444;
    }

    .main-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(15px);
        border-radius: 30px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(255, 182, 193, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.6);
        margin-bottom: 30px;
    }

    h2, h3 {
        color: #d63384;
        font-weight: 300;
        margin-top: 0;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: white;
        border-radius: 20px;
        overflow: hidden;
    }

        .custom-table th {
            background-color: #ffb6c1;
            color: white;
            padding: 15px;
            text-align: left;
        }

        .custom-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #ffe4e9;
            font-size: 0.9em;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .input-group {
        margin-bottom: 15px;
        text-align: left;
    }

    label {
        display: block;
        color: #ff85a1;
        margin-bottom: 5px;
        font-size: 0.85em;
        padding-left: 10px;
    }

    .input-field {
        padding: 12px 15px;
        border-radius: 20px;
        border: 2px solid #ffe4e9;
        outline: none;
        width: 100%;
        box-sizing: border-box;
        transition: 0.3s;
    }

    .btn {
        padding: 10px 20px;
        border-radius: 20px;
        border: none;
        cursor: pointer;
        transition: 0.3s;
        font-size: 0.9em;
    }

    .btn-save {
        background: #d63384;
        color: white;
        width: 100%;
        font-size: 1.1em;
        margin-top: 10px;
    }

    .btn-edit {
        background: #ffc1e3;
        color: #d63384;
    }

    .status-msg {
        margin-top: 15px;
        padding: 10px;
        border-radius: 15px;
        text-align: center;
        background: rgba(255, 255, 255, 0.5);
    }
</style>

<div class="main-container">
    @if (isAuthorized)
    {
        <button class="btn" style="background: white; border: 1px solid #ff85a1; color: #ff85a1; margin-bottom: 20px;" @onclick="GoBack">Back to Dashboard</button>

        <div class="glass-card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h2>Invoices Management</h2>
                <button class="btn btn-edit" @onclick="() => showAddForm = !showAddForm">
                    @(showAddForm ? "Close Form" : "➕ Add Invoice")
                </button>
            </div>

            @if (showAddForm)
            {
                <div style="margin-top: 20px; padding: 20px; border: 1px dashed #ffb6c1; border-radius: 20px;">
                    <h3>Create New Invoice</h3>
                    <div class="form-grid">
                        <div class="input-group">
                            <label>Employee ID</label>
                            <input type="number" class="input-field" @bind="newInvoice.EmployeeID" />
                        </div>
                        <div class="input-group">
                            <label>Hours</label>
                            <input type="number" class="input-field" @bind="newInvoice.Hours" />
                        </div>
                        <div class="input-group">
                            <label>Amount</label>
                            <input type="number" class="input-field" @bind="newInvoice.Amount" />
                        </div>
                        <div class="input-group">
                            <label>Date (YYYY-MM-DD)</label>
                            <input type="date" class="input-field" @onchange="OnDateChanged" />
                        </div>
                    </div>
                    <button class="btn btn-save" @onclick="HandleAddInvoice">Add to System</button>
                </div>
            }

            <table class="custom-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Employee ID</th>
                        <th>Hours</th>
                        <th>Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in allInvoices)
                    {
                        <tr>
                            <td>@inv.InvoiceID</td>
                            <td>@($"{inv.InvoiceDateTime.day}/{inv.InvoiceDateTime.month}/{inv.InvoiceDateTime.year}")</td>
                            <td>@inv.EmployeeID</td>
                            <td>@inv.Hours</td>
                            <td>@inv.Amount ₪</td>
                            <td>
                                <button class="btn btn-edit" @onclick="() => SelectForEdit(inv)">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (editModel != null)
        {
            <div class="glass-card" style="max-width: 500px; margin: 0 auto;">
                <h3>Edit Invoice #@editModel.InvoiceID</h3>
                <div class="input-group">
                    <label>Hours</label>
                    <input type="number" class="input-field" @bind="editModel.Hours" />
                </div>
                <div class="input-group">
                    <label>Amount</label>
                    <input type="number" class="input-field" @bind="editModel.Amount" />
                </div>
                <button class="btn btn-save" @onclick="HandleUpdate">Save Changes</button>
                <button class="btn" style="width:100%; margin-top:5px;" @onclick="() => editModel = null">Cancel</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="status-msg" style="color: #d63384;">@message</div>
        }
    }
    else
    {
        <div class="glass-card">Verifying Administrator Permissions...</div>
    }
</div>

@code {
    // Manual database initialization as per request
    private InvoiceDB invDb = new InvoiceDB();

    private List<Invoice> allInvoices = new();
    private Invoice newInvoice = new Invoice();
    private Invoice editModel = null;

    private bool isAuthorized = false;
    private bool showAddForm = false;
    private string message = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Session-based security check
            var result = await MySession.GetAsync<Employee>("CurrentUser");

            // Restricted to Managers only
            if (result.Success && result.Value != null && result.Value.IsManager)
            {
                isAuthorized = true;
                await LoadInvoices();
                StateHasChanged();
            }
            else
            {
                // Redirect unauthorized users
                NavManager.NavigateTo("/dashboard");
            }
        }
    }

    /// <summary>
    /// Fetches all invoices from the database
    /// </summary>
    private async Task LoadInvoices()
    {
        allInvoices = await invDb.GetAllInvoicesAsync();
    }

    /// <summary>
    /// Handles manual date input conversion for the custom Time model
    /// </summary>
    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value.ToString(), out DateTime dt))
        {
            newInvoice.InvoiceDateTime.ConvertIntToTime(dt.Year, dt.Month, dt.Day, dt.Hour, dt.Minute);
        }
    }

    /// <summary>
    /// Validates and adds a new invoice
    /// </summary>
    private async Task HandleAddInvoice()
    {
        // Manual Validation
        if (newInvoice.EmployeeID <= 0 || newInvoice.Hours <= 0 || newInvoice.Amount <= 0)
        {
            message = "Please fill all fields with valid positive values.";
            return;
        }

        try
        {
            await invDb.AddInvoiceAsync(newInvoice);
            message = "Invoice added successfully!";
            newInvoice = new Invoice(); // Reset
            showAddForm = false;
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            message = "Error adding invoice: " + ex.Message;
        }
    }

    /// <summary>
    /// Selects an invoice to be displayed in the edit section
    /// </summary>
    private void SelectForEdit(Invoice inv)
    {
        // Clone for safe editing
        editModel = new Invoice(inv.InvoiceID, inv.InvoiceDateTime, inv.EmployeeID, inv.Hours, inv.Amount);
        message = "";
    }

    /// <summary>
    /// Updates only the Amount and Hours of a specific invoice
    /// </summary>
    private async Task HandleUpdate()
    {
        if (editModel.Hours <= 0 || editModel.Amount <= 0)
        {
            message = "Hours and Amount must be greater than zero.";
            return;
        }

        try
        {
            await invDb.UpdateAmountAndHoursAsync(editModel.InvoiceID, editModel.Amount, editModel.Hours);
            message = "Invoice updated successfully!";
            editModel = null; // Hide edit form
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            message = "Update failed: " + ex.Message;
        }
    }

    private void GoBack() => NavManager.NavigateTo("/dashboard");
}