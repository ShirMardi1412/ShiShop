@page "/login"
@using Models
@using DBL
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject NavigationManager NavManager

<style>
    /* Cloud-like background with a soft pink gradient */
    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
        background: linear-gradient(135deg, #fff0f6 0%, #ffdde1 100%);
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Glassmorphism effect for the login container */
    .login-box {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 40px;
        padding: 40px;
        width: 360px;
        box-shadow: 0 15px 35px rgba(255, 182, 193, 0.4);
        text-align: center;
    }

    /* Soft feminine title */
    h2 {
        color: #d63384;
        font-weight: 300;
        margin-bottom: 30px;
        letter-spacing: 1px;
    }

    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

    label {
        display: block;
        color: #ff85a1;
        margin-bottom: 8px;
        margin-left: 10px;
        font-size: 0.9em;
    }

    /* Custom styled inputs */
    input {
        width: 100%;
        padding: 14px 20px;
        border-radius: 25px;
        border: 2px solid #ffe4e9;
        outline: none;
        box-sizing: border-box;
        background: white;
        transition: all 0.3s ease;
        color: #555;
    }

        input:focus {
            border-color: #ffb6c1;
            box-shadow: 0 0 8px rgba(255, 182, 193, 0.5);
        }

    /* Dreamy pink button */
    .btn-submit {
        background: linear-gradient(to right, #ff85a1, #f76c8e);
        color: white;
        border: none;
        padding: 14px;
        width: 100%;
        border-radius: 25px;
        cursor: pointer;
        font-size: 1.1em;
        margin-top: 10px;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 5px 15px rgba(247, 108, 142, 0.3);
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(247, 108, 142, 0.5);
        }

    /* Soft error message */
    .error-text {
        color: #e91e63;
        font-size: 0.85em;
        margin-top: 15px;
        background: rgba(255, 255, 255, 0.5);
        padding: 8px;
        border-radius: 10px;
    }
</style>

<div class="login-box">
    <h2>Welcome</h2>

    <div class="form-group">
        <label>National ID</label>
        <input type="text" @bind="nationalId" placeholder="Enter your ID" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input type="password" @bind="password" placeholder="••••••••" />
    </div>

    <button class="btn-submit" @onclick="ProcessLogin">Sign In</button>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="error-text">@statusMessage</div>
    }
</div>

@code {
    // Manual database access instance
    private EmployeeDB employeeDb = new EmployeeDB();

    // Bound properties for input fields
    private string nationalId = "";
    private string password = "";
    private string statusMessage = "";

    /// <summary>
    /// Handles the login process including validation, database check,
    /// and session storage of the full employee object.
    /// </summary>
    private async Task ProcessLogin()
    {
        // Internal validation check
        if (string.IsNullOrWhiteSpace(nationalId) || string.IsNullOrWhiteSpace(password))
        {
            statusMessage = "Please provide both ID and password.";
            return;
        }

        try
        {
            // Attempt to authenticate against the database
            Employee loggedInUser = await employeeDb.LoginAsync(nationalId, password);

            if (loggedInUser != null)
            {
                statusMessage = "";

                // Store the complete Employee object in the protected session storage
                // This allows us to check loggedInUser.IsManager in other pages
                await MySession.SetAsync("CurrentUser", loggedInUser);

                // Redirect to the dashboard or home page
                NavManager.NavigateTo("/dashboard");
            }
            else
            {
                statusMessage = "Access denied. Check your credentials or account status.";
            }
        }
        catch (Exception ex)
        {
            // Log error internally if needed
            statusMessage = "A connection error occurred. Please try again later.";
        }
    }
}